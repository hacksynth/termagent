<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Agent talks to an OpenAI-compatible endpoint; shell backend needs no network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Both are used by AgentForegroundService, which is started for the duration of a turn:
        a turn can run a command for minutes, and a backgrounded process would otherwise be frozen
        (which suspends the timers the command capture depends on) or killed outright.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!--
        `allowBackup` is deliberately FALSE.

        The app's settings hold provider API keys in plain SharedPreferences (see SECURITY.md), and
        its private storage holds the whole unpacked Termux `$PREFIX` — hundreds of megabytes of
        binaries and package metadata, plus the user's shell history and any file the agent wrote.
        Neither belongs in an ADB backup, a cloud backup, or a device-to-device transfer: the backup
        file leaves the app's sandbox and can be read off the wire.

        `dataExtractionRules` (below, API 31+) states the same for the newer backup/transfer paths.
        The trade-off is accepted on purpose: there is no app data worth restoring that the user
        cannot recreate by re-installing the bootstrap (which ships inside the APK).
    -->
    <application
        android:name=".TermAgentApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        tools:ignore="UnusedAttribute"
        tools:targetApi="tiramisu">

        <!--
            `locale` is deliberately NOT in configChanges.

            Handling it here would keep the activity alive across a system-language change and
            rely on every consumer re-reading its resources. Letting Android recreate the
            activity instead is the documented contract for "follow the system language": the
            whole Compose tree is rebuilt against the new `Resources`, so nothing can hold on to
            a string from the previous locale. Everything else (density, font scale, uiMode, …)
            stays handled, so those changes still avoid a recreation.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|mnc|colorMode|density|fontScale|fontWeightAdjustment|keyboard|layoutDirection|mcc|navigation|smallestScreenSize|touchscreen|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Lifetime marker for one agent turn: keeps the process unfrozen and the CPU awake while a
            command is running, so a long `apt install` survives the user switching apps.
            Not exported (nothing outside the app can start it) and not sticky (a turn cannot be
            resumed across process death). See AgentForegroundService.
        -->
        <service
            android:name=".agent.AgentForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            tools:targetApi="q" />
    </application>

</manifest>
