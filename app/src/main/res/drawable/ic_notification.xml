        android:fillColor="#FFFFFF"
        android:pathData="M4.6,4.9L10.9,11.2C11.35,11.65 11.35,12.35 10.9,12.8L4.6,19.1C4.16,19.55 3.44,19.55 3,19.1C2.55,18.66 2.55,17.94 3,17.5L8.3,12.2L3,6.5C2.55,6.06 2.55,5.34 3,4.9C3.44,4.45 4.16,4.45 4.6,4.9Z" />
